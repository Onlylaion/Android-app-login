<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base: Material 3 con la paleta de colors.xml (en modo oscuro, values-night/colors.xml) -->
    <style name="Base.Theme.LogginGym" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/azul_suave</item>
        <item name="colorOnPrimaryContainer">@color/primario_oscuro</item>
        <item name="colorSecondary">@color/primario</item>
        <item name="colorError">@color/rojo</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorOutline">@color/borde</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <!-- Transición entre pantallas (anim/*.xml) -->
        <item name="android:windowAnimationStyle">@style/AnimacionActividades</item>
    </style>

    <style name="Theme.LogginGym" parent="Base.Theme.LogginGym" />

    <!-- Entrar: la pantalla nueva se desliza desde la derecha. Volver: sale hacia la derecha -->
    <style name="AnimacionActividades" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/entrar_desde_derecha</item>
        <item name="android:activityOpenExitAnimation">@anim/salir_hacia_izquierda</item>
        <item name="android:activityCloseEnterAnimation">@anim/entrar_desde_izquierda</item>
        <item name="android:activityCloseExitAnimation">@anim/salir_hacia_derecha</item>
    </style>

    <!-- ===== Textos ===== -->
    <style name="Texto.Titulo" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="Texto.Subtitulo" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="Texto.ItemTitulo" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
    </style>

    <style name="Texto.ItemDetalle" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <!-- ===== Botones ===== -->
    <style name="Boton.Primario" parent="Widget.Material3.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/primario</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Boton.Volver" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/primario</item>
        <item name="android:paddingStart">4dp</item>
        <item name="icon">@drawable/ic_arrow_back</item>
        <item name="iconTint">@color/primario</item>
    </style>

    <!-- ===== Tarjetas y campos ===== -->
    <style name="Tarjeta" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
    </style>

    <style name="Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/primario</item>
        <item name="hintTextColor">@color/primario</item>
        <item name="startIconTint">@color/texto_secundario</item>
    </style>
</resources>
