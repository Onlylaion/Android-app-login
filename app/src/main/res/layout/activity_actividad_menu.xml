<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActividadMenu">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom|center_horizontal|top|center_vertical|fill_vertical"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="-134dp"
        tools:layout_editor_absoluteY="-84dp">

        <Button
            android:id="@+id/btnAbrirPuerta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="goToActivityAperturaPuerta"
            android:text="Abrir Puerta" />

        <Button
            android:id="@+id/button4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="clip_horizontal|center"
            android:onClick="verPersonasEnGym"
            android:text="Ver la cantidad de personas en el gym ahora" />

        <Button
            android:id="@+id/button5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="verPagos"
            android:text="Ver Pagos" />

        <Button
            android:id="@+id/button6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="cerrarSesion"
            android:text="Salir" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>